<Project Sdk="Microsoft.NET.Sdk">
  <!-- Imports silksong path properties (gitignored) so CI can override the game path. -->
  <Import Condition="Exists('SilksongPath.props')" Project="SilksongPath.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>CrestPicker</AssemblyName>
    <RootNamespace>CrestPicker</RootNamespace>
    <Product>CrestPicker</Product>
    <!-- Ignore processor architecture mismatch from game assemblies. -->
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>

  <!--
    Reference the game and BepInEx assemblies straight from the local install.
    Avoids the bepinex.dev NuGet feed, which is unreachable/slow on this machine.
  -->
  <PropertyGroup>
    <GameManagedDir>$(SilksongFolder)/Hollow Knight Silksong_Data/Managed</GameManagedDir>
    <BepInExCoreDir>$(SilksongFolder)/BepInEx/core</BepInExCoreDir>
  </PropertyGroup>

  <!-- The unit test project lives in a subfolder and must not be compiled into the mod. -->
  <ItemGroup>
    <Compile Remove="CrestPicker.Tests/**" />
    <None Remove="CrestPicker.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(GameManagedDir)/UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TeamCherry.Localization">
      <HintPath>$(GameManagedDir)/TeamCherry.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TeamCherry.NestedFadeGroup">
      <HintPath>$(GameManagedDir)/TeamCherry.NestedFadeGroup.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(GameManagedDir)/PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TeamCherry.TK2D">
      <HintPath>$(GameManagedDir)/TeamCherry.TK2D.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy the built plugin into BepInEx/plugins so the game picks it up. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(SilksongPluginsFolder)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SilksongPluginsFolder)" />
  </Target>
</Project>
